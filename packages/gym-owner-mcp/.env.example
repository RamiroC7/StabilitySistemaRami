# Connection string del rol gym_owner_readonly por el transaction pooler (puerto 6543).
# El usuario es "gym_owner_readonly.<project-ref>". NO usar la conexion directa (:5432).
GYM_OWNER_RO_DATABASE_URL=postgresql://gym_owner_readonly.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Connection string del rol gym_mcp_service (schema gym_mcp: tokens OAuth + audit log).
# Nunca tiene acceso a "public" - ver supabase/migrations/20260912000000_gym_owner_mcp_setup.sql.
GYM_MCP_SERVICE_DATABASE_URL=postgresql://gym_mcp_service.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# (Fase C, T12+) URL y anon key del proyecto Supabase real, para el login OAuth
# (supabase-js client-side) y la verificacion server-side via /auth/v1/user.
SUPABASE_URL=
SUPABASE_ANON_KEY=
