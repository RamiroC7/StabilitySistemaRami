{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "build",
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src"],
  // Los .test.ts no van al build: si se compilan, vitest los descubre TAMBIEN
  // ahi (ademas de en src/) y corre cada test dos veces contra un snapshot
  // viejo del codigo — causo fallas reales por "Cannot find package
  // @stability/domain" contra una copia stale de build/ mientras se corrian
  // los tests de verdad en Windows.
  "exclude": ["src/**/*.test.ts"]
}
