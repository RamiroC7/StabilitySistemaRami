# Connection string del rol mcp_readonly por el transaction pooler (puerto 6543).
# El usuario es "mcp_readonly.<project-ref>". NO usar la conexion directa (:5432, solo IPv6).
DATABASE_URL=postgresql://mcp_readonly.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# (Fase 4 / T10) Token de acceso personal para modo stdio. Resuelve a un profiles.id con role=coach.
MCP_ACCESS_TOKEN=

# (Fase 4 / T16, transport HTTP) Hosts permitidos para proteccion de DNS rebinding.
MCP_HOST=localhost
