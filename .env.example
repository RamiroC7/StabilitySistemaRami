# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog Analytics Configuration
VITE_POSTHOG_PROJECT_ID=554935
VITE_POSTHOG_PERSONAL_API_KEY=your-posthog-personal-api-key-here
VITE_POSTHOG_HOST=https://us.posthog.com

# Sentry (captura de errores en producción)
# DSN del proyecto en https://sentry.io — Settings > Projects > (tu proyecto) > Client Keys (DSN)
# Vacío en dev local: si no está seteada, Sentry simplemente no se inicializa.
VITE_SENTRY_DSN=

# Solo para el build en Vercel (no van en este .env, van como env vars del
# proyecto en Vercel) — habilitan la subida de source maps:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
